# ============================================================================
# ResQ-Go — environment reference
# ============================================================================
#
# Copy to `.env` at the repository root and adjust:
#   cp .env.example .env          (Git Bash / macOS / Linux)
#   copy .env.example .env        (Windows cmd / PowerShell)
#
# `.env` is gitignored. `.env.example` is tracked and must never contain a real
# secret.
#
# ---------------------------------------------------------------------------
# Which variables are read by what
# ---------------------------------------------------------------------------
# API (apps/api)                WEB (apps/web)
#   JWT_SECRET        required     NEXT_PUBLIC_API_URL
#   JWT_EXPIRES_IN    optional
#   BCRYPT_ROUNDS     optional   Both apps read the values below.
#   CORS_ORIGIN       optional     POSTGRES_USER
#   DATABASE_URL      required     POSTGRES_PASSWORD
#   PORT              optional     POSTGRES_DB
#   NODE_ENV          optional
# ============================================================================

# ----------------------------------------------------------------------------
# Shared secrets
# ----------------------------------------------------------------------------

# Signing key for access tokens. REQUIRED — the API refuses to start without it.
# Generate a fresh one for every environment:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# In production it must be at least 32 characters and must not be a known
# placeholder; the API rejects those values at boot rather than at first use.
JWT_SECRET=change-me-generate-a-random-48-byte-hex-string

# How long an access token stays valid.
JWT_EXPIRES_IN="12h"

# Password hashing work factor. 10 is fine locally; use 12 or higher in
# production (each +1 roughly doubles hashing time).
BCRYPT_ROUNDS=10

# ----------------------------------------------------------------------------
# Database
# ----------------------------------------------------------------------------
# Local development: matches the credentials in docker-compose.yml.
DATABASE_URL=postgresql://abs:abs_dev_password@localhost:5432/abs

# Used by docker-compose.yml only. Keep these in sync with DATABASE_URL above.
POSTGRES_USER=abs
POSTGRES_PASSWORD=abs_dev_password
POSTGRES_DB=abs

# ----------------------------------------------------------------------------
# API
# ----------------------------------------------------------------------------

# Port the NestJS server listens on. The Docker image and Compose expose 3001.
PORT=3001

# Comma-separated list of browser origins allowed to call the API with
# credentials. Wildcards are rejected. Production must name the web origin.
CORS_ORIGIN=http://localhost:3000

# development | production | test
NODE_ENV=development

# ----------------------------------------------------------------------------
# Web
# ----------------------------------------------------------------------------

# Base URL of the API, including the version prefix. Inlined into the browser
# bundle at build time, so it must be correct when the image is built.
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# ----------------------------------------------------------------------------
# Running the whole stack with Docker (recommended for a first run)
# ----------------------------------------------------------------------------
#   docker compose up --build
#
# The web app runs on http://localhost:3000 and the API on http://localhost:3001.
# Schema changes are applied automatically; demo accounts are seeded locally.
# ----------------------------------------------------------------------------

# Running only the database in Docker, with the apps on the host:
#   docker compose -f infra/docker-compose.yml up -d postgres
#   npm run db:push
#   npm run db:seed
#   npm run dev:api
#   npm run dev:web

# Running everything on the host without Docker: you need your own PostgreSQL,
# then point DATABASE_URL at it.
# ----------------------------------------------------------------------------