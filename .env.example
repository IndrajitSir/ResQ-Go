# ---- API (apps/api) ----
# Local development uses SQLite by default (see docs/KNOWLEDGE_BASE.md for the trade-off).
# For Docker/production, use the PostgreSQL URL from docker-compose.yml.
DATABASE_URL="file:./dev.db"

# JWT signing secret. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-in-local-dev-only"
JWT_EXPIRES_IN="12h"

# Refresh token lifetime
JWT_REFRESH_EXPIRES_IN="7d"

# API port
PORT=3001
CORS_ORIGIN=http://localhost:3000

# bcrypt cost factor (12 recommended in production)
BCRYPT_ROUNDS=10

# ---- Web (apps/web) ----
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# ---- Postgres (used only when running via infra/docker-compose.yml) ----
POSTGRES_USER=abs
POSTGRES_PASSWORD=abs_dev_password
POSTGRES_DB=abs
