# ============================================================================
# ResQ-Go — Environment reference
# ============================================================================
#
# Two production targets are supported:
#   1. Render Blueprint (render.yaml)  → full-stack, PostgreSQL, in-dashboard
#   2. Vercel (apps/web) + Render API  → web on Vercel, API on a Render Web Service
#
# For local development, see the Docker workflow below.
# ============================================================================

# ============================================================================
# Both targets (shared secrets)
# ============================================================================
# JWT signing secret. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-in-local-dev-only
JWT_EXPIRES_IN="12h"
JWT_REFRESH_EXPIRES_IN="7d"

# ============================================================================
# 1. Render Blueprint (render.yaml)
# ============================================================================
# Set these ONLY if deploying through the Render dashboard's "Blueprint" flow
# or when overriding the template in render.yaml for a manual service.
#
# DATABASE_URL will be injected automatically by the blueprint from the
# PostgreSQL service it creates. Do NOT set it alongside the blueprint.
DATABASE_URL=postgresql://placeholder:placeholder@localhost:5432/resqgo
CORS_ORIGIN=https://resq-go.vercel.app   # change if web is hosted elsewhere
BCRYPT_ROUNDS=12
PORT=3001

# ============================================================================
# 2. Vercel (web) + separate Render API service
# ============================================================================
# Vercel reads .env.local / Vercel Environment Variables for the web side.
# The Render API service reads the Render Dashboard Environment Variables.
NEXT_PUBLIC_API_URL=https://resq-go.onrender.com/api/v1   # Vercel env var

# ============================================================================
# Local development (Docker Compose PostgreSQL)
# ============================================================================
# Start the DB:
#   docker compose -f infra/docker-compose.yml up -d postgres
#
# Then:
#   npm run dev --workspace @abs/api   # port 3001
#   npm run dev --workspace @abs/web   # port 3000
#
# The API reads .env; the web reads .env.local (or env vars).
DATABASE_URL=postgresql://abs:abs_dev_password@localhost:5432/abs
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
CORS_ORIGIN=http://localhost:3000
BCRYPT_ROUNDS=10

# Postgres credentials used by docker-compose.yml only. Keep in sync.
POSTGRES_USER=abs
POSTGRES_PASSWORD=abs_dev_password
POSTGRES_DB=abs
