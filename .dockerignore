# Keep the build context small and free of anything that could leak into an
# image. Everything here is either regenerated during the build or is local-only.

# Dependencies and build output (all regenerated inside the image)
node_modules
**/node_modules
dist
**/dist
.next
**/.next
out
**/out
coverage
**/coverage
*.tsbuildinfo

# Secrets and environment — must never be baked into an image
.env
.env.*
!.env.example

# Local toolchain cache and workspace metadata
.toolcache
.freebuff

# Databases and logs
apps/api/prisma/*.db
apps/api/prisma/*.db-journal
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Version control and CI
.git
.github
.gitignore

# Documentation is not needed at runtime
docs
*.md
!README.md

# Editor and OS noise
.vscode
.idea
.DS_Store
Thumbs.db
*.swp
*.swo

# Temporary files
*.tmp
*.temp
.cache